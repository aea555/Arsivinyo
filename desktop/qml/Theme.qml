        "light.warm": { "accent": "#f97316", "accentHover": "#ea580c", "background": "#fffbeb", "border": "#fde68a", "borderSubtle": "#fcd34d", "error": "#dc2626", "info": "#2563eb", "overlay": "#80451a03", "primary": "#b45309", "primaryHover": "#92400e", "primaryText": "#ffffff", "success": "#16a34a", "surface": "#fef3c7", "surfaceActive": "#fcd34d", "surfaceHover": "#fde68a", "text": "#451a03", "textMuted": "#78350f", "textSubtle": "#92400e", "warning": "#d97706" },
        "light.cool": { "accent": "#0ea5e9", "accentHover": "#0284c7", "background": "#f0f9ff", "border": "#bae6fd", "borderSubtle": "#7dd3fc", "error": "#dc2626", "info": "#2563eb", "overlay": "#800c4a6e", "primary": "#0284c7", "primaryHover": "#0369a1", "primaryText": "#ffffff", "success": "#16a34a", "surface": "#e0f2fe", "surfaceActive": "#7dd3fc", "surfaceHover": "#bae6fd", "text": "#0c4a6e", "textMuted": "#0369a1", "textSubtle": "#0284c7", "warning": "#d97706" },
        "light.paper": { "accent": "#b7791f", "accentHover": "#975f13", "background": "#faf6ef", "border": "#e0d8ca", "borderSubtle": "#ece5d9", "error": "#b83227", "info": "#2b6cb0", "overlay": "#59000000", "primary": "#3b3630", "primaryHover": "#2a2621", "primaryText": "#faf6ef", "success": "#4d7c2a", "surface": "#f2ece1", "surfaceActive": "#ddd3c2", "surfaceHover": "#e8e0d2", "text": "#3b3630", "textMuted": "#6b6257", "textSubtle": "#918778", "warning": "#b7791f" },
        "light.frost": { "accent": "#2b7fd4", "accentHover": "#1d63ab", "background": "#f5f8fa", "border": "#dbe3ea", "borderSubtle": "#eaf0f5", "error": "#c53030", "info": "#2b7fd4", "overlay": "#590f172a", "primary": "#1f2933", "primaryHover": "#111820", "primaryText": "#ffffff", "success": "#2f855a", "surface": "#ffffff", "surfaceActive": "#dbe5ee", "surfaceHover": "#eaf0f5", "text": "#1f2933", "textMuted": "#52616b", "textSubtle": "#7b8794", "warning": "#b7791f" }
    })

    /** Falls back to the default of the current mode, so a stale setting cannot blank the UI. */
    readonly property var active: palettes[mode + "." + variant]
                                  || palettes[mode === "dark" ? "dark.zinc" : "light.neutral"]

    readonly property bool isDark: mode === "dark"

    readonly property color accent: active.accent
    readonly property color accentHover: active.accentHover
    readonly property color background: active.background
    readonly property color border: active.border
    readonly property color borderSubtle: active.borderSubtle
    readonly property color error: active.error
    readonly property color info: active.info
    readonly property color overlay: active.overlay
    readonly property color primary: active.primary
    readonly property color primaryHover: active.primaryHover
    readonly property color primaryText: active.primaryText
    readonly property color success: active.success
    readonly property color surface: active.surface
    readonly property color surfaceActive: active.surfaceActive
    readonly property color surfaceHover: active.surfaceHover
    readonly property color text: active.text
    readonly property color textMuted: active.textMuted
    readonly property color textSubtle: active.textSubtle
    readonly property color warning: active.warning

    function apply(nextMode, nextVariant) {
        mode = nextMode
        variant = nextVariant
    }

    property Settings _saved: Settings {
        category: "appearance"
        property alias mode: theme.mode
        property alias variant: theme.variant
    }
}
