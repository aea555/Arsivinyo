    readonly property var variants: mode === "dark" ? darkVariants : lightVariants

    readonly property var palettes: ({
        "dark.zinc": { "accent": "#22d3ee", "accentHover": "#06b6d4", "background": "#09090b", "border": "#27272a", "borderSubtle": "#3f3f46", "error": "#ef4444", "info": "#3b82f6", "overlay": "#b2000000", "primary": "#f4f4f5", "primaryHover": "#e4e4e7", "primaryText": "#09090b", "success": "#22c55e", "surface": "#18181b", "surfaceActive": "#3f3f46", "surfaceHover": "#27272a", "text": "#fafafa", "textMuted": "#a1a1aa", "textSubtle": "#71717a", "warning": "#f59e0b" },
        "dark.slate": { "accent": "#60a5fa", "accentHover": "#3b82f6", "background": "#020617", "border": "#1e293b", "borderSubtle": "#334155", "error": "#ef4444", "info": "#3b82f6", "overlay": "#b2020617", "primary": "#e2e8f0", "primaryHover": "#cbd5e1", "primaryText": "#020617", "success": "#22c55e", "surface": "#0f172a", "surfaceActive": "#334155", "surfaceHover": "#1e293b", "text": "#f8fafc", "textMuted": "#94a3b8", "textSubtle": "#64748b", "warning": "#f59e0b" },
        "dark.crimson": { "accent": "#f87171", "accentHover": "#ef4444", "background": "#0a0a0a", "border": "#262626", "borderSubtle": "#404040", "error": "#ef4444", "info": "#3b82f6", "overlay": "#b20a0a0a", "primary": "#dc2626", "primaryHover": "#b91c1c", "primaryText": "#ffffff", "success": "#22c55e", "surface": "#171717", "surfaceActive": "#404040", "surfaceHover": "#262626", "text": "#fafafa", "textMuted": "#a3a3a3", "textSubtle": "#737373", "warning": "#f59e0b" },
        "dark.emerald": { "accent": "#34d399", "accentHover": "#10b981", "background": "#022c22", "border": "#065f46", "borderSubtle": "#047857", "error": "#ef4444", "info": "#3b82f6", "overlay": "#b2022c22", "primary": "#10b981", "primaryHover": "#059669", "primaryText": "#022c22", "success": "#22c55e", "surface": "#064e3b", "surfaceActive": "#047857", "surfaceHover": "#065f46", "text": "#ecfdf5", "textMuted": "#a7f3d0", "textSubtle": "#6ee7b7", "warning": "#f59e0b" },
        "dark.midnight": { "accent": "#7aa2f7", "accentHover": "#5d87e8", "background": "#0f1419", "border": "#212936", "borderSubtle": "#2d3748", "error": "#f7768e", "info": "#7dcfff", "overlay": "#b2000000", "primary": "#e2e8f0", "primaryHover": "#cbd5e1", "primaryText": "#0f1419", "success": "#9ece6a", "surface": "#171d25", "surfaceActive": "#2d3748", "surfaceHover": "#212936", "text": "#e2e8f0", "textMuted": "#94a3b8", "textSubtle": "#64748b", "warning": "#e0af68" },
        "dark.ember": { "accent": "#f0a35e", "accentHover": "#dc8a41", "background": "#1a1512", "border": "#322820", "borderSubtle": "#43352a", "error": "#e26d5c", "info": "#7aa6c2", "overlay": "#b8000000", "primary": "#f5ebe0", "primaryHover": "#e6d7c7", "primaryText": "#1a1512", "success": "#8fb573", "surface": "#241d18", "surfaceActive": "#43352a", "surfaceHover": "#322820", "text": "#f5ebe0", "textMuted": "#b9a48f", "textSubtle": "#8a7663", "warning": "#e6b450" },
