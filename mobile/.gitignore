keystore.properties
signing.properties
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android
/google-services.json
/devdocs

local.properties.*
ffmpeg-kit-*

# local-downloader generated artifacts
modules/local-downloader/android/build/
# CMake/ninja output for libaudiopresets.so. The C++ SOURCES under src/main/cpp are
# tracked; this is only the generated build tree (per-ABI object dirs, ninja files,
# CMake caches) that the Android Gradle plugin regenerates on every build.
modules/local-downloader/android/.cxx/
modules/local-downloader/tests/__pycache__/*.pyc

# local-downloader ffmpeg binaries and native libs
modules/local-downloader/android/src/main/jniLibs/
# The binaries are ignored, the README that explains the directory is not. Ignoring the
# directory outright dropped both READMEs from the repository the moment their path
# changed, because an ignore rule does not spare a file that git sees as new.
modules/local-downloader/android/src/main/assets/ffmpeg/arm64-v8a/*
!modules/local-downloader/android/src/main/assets/ffmpeg/arm64-v8a/README.txt
modules/local-downloader/android/src/main/assets/ffmpeg/x86_64/*
!modules/local-downloader/android/src/main/assets/ffmpeg/x86_64/README.txt

*.whl
SHA256SUMS
*.pyc
__pycache__
*.lck
*.part

.vscode/