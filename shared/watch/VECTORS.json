            "season": 1,
            "number": 2
          },
          {
            "id": "tt1:1:1",
            "title": "a1",
            "season": 1,
            "episode": 1
          }
        ],
        "trailerStreams": [
          {
            "title": "Show",
            "ytId": "KPLWWIOCOOQ"
          }
        ]
      },
      "order": [
        "tt1:1:1",
        "tt1:1:2",
        "tt1:2:1",
        "tt1:0:1"
      ],
      "titles": [
        "a1",
        "a2",
        "b",
        "special"
      ],
      "trailers": [
        "https://www.youtube.com/watch?v=KPLWWIOCOOQ"
      ],
      "why": "episodes in order with specials last, named by title or name, numbered by episode or number; trailers as YouTube streams"
    }
  ]
}
