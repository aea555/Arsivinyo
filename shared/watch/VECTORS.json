{
  "comment": "The Stremio add-on protocol as both apps must read it (shared/watch/CONTRACT.md). Each app's tests run every case here.",
  "bases": [
    {
      "input": "https://v3-cinemeta.strem.io/manifest.json",
      "base": "https://v3-cinemeta.strem.io",
      "why": "a manifest URL is the add-on's base plus manifest.json"
    },
    {
      "input": "https://v3-cinemeta.strem.io/",
      "base": "https://v3-cinemeta.strem.io",
      "why": "a trailing slash is not part of the base"
    },
    {
      "input": "stremio://example.com/abc/manifest.json",
      "base": "https://example.com/abc",
      "why": "the stremio:// scheme is https"
    },
    {
      "input": "  https://example.com/a%7Cb/manifest.json  ",
      "base": "https://example.com/a%7Cb",
      "why": "whitespace is trimmed, and an encoded path is kept as it was given"
    },
    {
      "input": "http://192.168.1.5:7000/manifest.json",
      "base": "http://192.168.1.5:7000",
      "why": "plain http stays plain http"
    },
    {
      "input": "ftp://example.com/manifest.json",
      "base": null,
      "why": "only http(s) and stremio://"
    },
    {
      "input": "not a url",
      "base": null,
      "why": "not a URL at all"
    }
  ],
  "resources": [
    {
      "base": "https://v3-cinemeta.strem.io",
      "resource": "catalog",
      "type": "movie",
      "id": "top",
      "extra": [],
