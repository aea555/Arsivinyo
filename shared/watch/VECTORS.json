    },
    {
      "base": "https://v3-cinemeta.strem.io",
      "resource": "meta",
      "type": "series",
      "id": "tt0944947",
      "extra": [],
      "url": "https://v3-cinemeta.strem.io/meta/series/tt0944947.json"
    },
    {
      "base": "https://addon.example/cfg=abc",
      "resource": "stream",
      "type": "series",
      "id": "tt0944947:1:2",
      "extra": [],
      "url": "https://addon.example/cfg=abc/stream/series/tt0944947%3A1%3A2.json"
    },
    {
      "base": "https://addon.example",
      "resource": "catalog",
      "type": "movie",
      "id": "türk filmleri",
      "extra": [
        [
          "search",
          "çağan & ışık/2"
        ]
      ],
      "url": "https://addon.example/catalog/movie/t%C3%BCrk%20filmleri/search=%C3%A7a%C4%9Fan%20%26%20%C4%B1%C5%9F%C4%B1k%2F2.json"
    }
  ],
  "supports": {
    "manifest": {
      "id": "org.example.mixed",
      "version": "1.0.0",
      "name": "Mixed",
      "types": [
        "movie",
        "series"
      ],
      "idPrefixes": [
        "tt"
      ],
      "resources": [
        "catalog",
        {
          "name": "stream",
          "types": [
            "movie",
            "series"
          ],
          "idPrefixes": [
            "tt",
            "kitsu:"
          ]
        },
        {
          "name": "meta",
          "types": [
            "series"
          ]
        }
      ],
      "catalogs": [
        {
          "type": "movie",
          "id": "top",
          "name": "Top"
        }
      ],
      "addonCatalogs": [
        {
          "type": "all",
          "id": "official",
          "name": "Official"
        },
        {
          "type": "movie",
          "id": "official",
          "name": "Official"
        }
      ]
    },
    "cases": [
      {
        "resource": "stream",
        "type": "movie",
        "id": "tt0111161",
        "expect": true,
        "why": "a resource object's own types and prefixes"
      },
      {
        "resource": "stream",
        "type": "series",
        "id": "kitsu:1:2",
        "expect": true,
        "why": "a prefix only the resource lists"
      },
      {
        "resource": "stream",
        "type": "channel",
        "id": "tt1",
        "expect": false,
        "why": "a type the resource does not list"
      },
      {
        "resource": "meta",
        "type": "series",
        "id": "tt0944947",
        "expect": true,
        "why": "no prefixes on the resource: the manifest's apply"
      },
      {
        "resource": "meta",
        "type": "series",
        "id": "yt_id:abc",
        "expect": false,
        "why": "the manifest's prefixes rule it out"
      },
      {
        "resource": "meta",
        "type": "movie",
        "id": "tt1",
        "expect": false,
        "why": "the resource's types rule it out"
      },
      {
        "resource": "catalog",
        "type": "movie",
        "id": "top",
        "expect": true,
        "why": "a resource named by string takes the manifest's types, and catalogs are not checked for prefixes"
      },
      {
        "resource": "subtitles",
        "type": "movie",
        "id": "tt1",
        "expect": false,
        "why": "a resource it does not have"
      }
    ]
  },
