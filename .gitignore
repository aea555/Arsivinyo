# Repository-wide ignores. Each app keeps its own .gitignore for its build output —
# see mobile/.gitignore, whose patterns are relative to that directory.

# Working notes, not part of the project.
/devdocs

# Python bytecode from the shared engine.
__pycache__/
*.pyc

# Built artifacts kept for a release upload. Never committed - a release page holds them.
/dist

# Editor
.vscode/

# OS
.DS_Store

# Secrets. Repeated per app, but a stray key at the root must never be committed.
*.jks
*.keystore
*.p8
*.p12
*.pem
*.key
keystore.properties
signing.properties
.env
.env*.local

# Stray CMake probe output at the repository root.
/CMakeFiles/
/CMakeCache.txt

# yt-dlp is fetched, not vendored: 13 MB across a thousand files, and the app updates it
# itself the way the phone does. `python3 shared/engine/ytdlp_updater.py shared/engine`
# fills it in, and the Update action in Settings does the same at runtime.
/shared/engine/yt-dlp/
/shared/engine/yt-dlp-overrides/
